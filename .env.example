# Caminho opcional para a planilha oficial de planejamento financeiro da CTI Global
# Se omitido, o sistema busca automaticamente na pasta data/raw/ ou na raiz do projeto,
# ou permite o envio seguro via interface (st.file_uploader).
CTI_EXCEL_PATH=data/raw/Contabilidade e Finanças.xlsx

# Diretório para artefatos das camadas staging e processed
CTI_DATA_DIR=data

# Modo de demonstração sintética pública (false por padrão; ative apenas se autorizado para demo sem dados reais)
CTI_ALLOW_SYNTHETIC_DEMO=false

# ==============================================================================
# SEGURANÇA E AUTENTICAÇÃO CORPORATIVA CTI GLOBAL
# ==============================================================================
# Usuário administrativo inicial
CTI_AUTH_USER=admin

# Hash bcrypt da senha de produção (exemplo abaixo é o hash de 'admin123' com 12 rounds)
# Para gerar um novo hash seguro, execute: python -c "import bcrypt; print(bcrypt.hashpw(b'nova_senha', bcrypt.gensalt(12)).decode())"
CTI_AUTH_PASSWORD_HASH=$2b$12$5ObbbRYannus1KMDHO6Q4OhLORKeA7jHmRjsHn6RRGRWPpvh/J0sS

# Senha em texto puro (OPCIONAL apenas para conveniência em desenvolvimento local; NUNCA use em produção)
# CTI_AUTH_PASSWORD=admin123

# Tempo de expiração de sessão por inatividade em minutos (padrão: 30 minutos)
CTI_SESSION_TIMEOUT_MINUTES=30

# Limite de tentativas consecutivas incorretas antes do bloqueio (Rate Limiting de força bruta)
CTI_MAX_LOGIN_ATTEMPTS=5

# Duração do bloqueio temporário em minutos após exceder o limite (padrão: 15 minutos)
CTI_LOCKOUT_MINUTES=15

